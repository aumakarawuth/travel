# ---------- Public (exposed to browser) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser key restricted by HTTP referrer + Maps JavaScript API only (Phase 3)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ---------- Server only (NEVER prefix with NEXT_PUBLIC_) ----------
SUPABASE_SERVICE_ROLE_KEY=
# Server key restricted to Places/Geocoding/Routes APIs (Phase 2-4)
GOOGLE_MAPS_SERVER_KEY=
# AI provider: "gemini" | "claude" | "mock"
AI_PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Cost guardrails (Phase 2+)
AI_MAX_JOBS_PER_USER_PER_DAY=50
AI_MAX_JOBS_PER_TRIP_PER_DAY=200
LINK_SUBMISSIONS_PER_MINUTE=10
# Secret used by Vercel Cron to call the job worker (Phase 2)
CRON_SECRET=

# ---------- Single-user mode (no login screen) ----------
# The server signs in as this built-in account automatically. Server only.
APP_USER_EMAIL=owner@tripsync.local
APP_USER_PASSWORD=

# ---------- Phase 2 (optional model overrides) ----------
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-haiku-5-5
